rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // A missing role is treated as a normal user. Only trusted Admin SDK
    // code may assign custom claims; clients cannot promote themselves.
    function role() {
      return signedIn() ? request.auth.token.get("role", "user") : null;
    }

    function isSuperAdmin() {
      return role() == "super_admin";
    }

    function isAdmin() {
      return role() in ["super_admin", "admin"];
    }

    function isStaff() {
      return role() in ["super_admin", "admin", "assistant"];
    }

    function ownsDevice(deviceId) {
      return signedIn()
        && exists(/databases/$(database)/documents/devices/$(deviceId))
        && get(/databases/$(database)/documents/devices/$(deviceId)).data.ownerUid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["displayName", "email", "createdAt", "updatedAt"])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100;
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["displayName", "updatedAt"])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100;
      allow delete: if isSuperAdmin();
    }

    match /devices/{deviceId} {
      allow read: if isStaff() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      // Device identity, enrollment credentials and check-ins are server-managed.
      allow create, update, delete: if false;
    }

    match /device_policies/{deviceId} {
      allow read: if isStaff() || ownsDevice(deviceId);
      allow create, update: if isAdmin()
        && request.resource.data.deviceId == deviceId
        && request.resource.data.keys().hasOnly([
          "deviceId", "version", "updatedAt", "updatedBy",
          "noFactoryReset", "noDebuggingFeatures", "noSafeBoot",
          "disableCamera", "noInstallUnknownSources", "noModifyAccounts",
          "noUsbFileTransfer", "noConfigTethering", "noUninstallApps",
          "kioskMode", "lockMessage", "requireStorageEncryption",
          "passwordQuality", "passwordMinLength", "passwordExpiryDays",
          "screenLockTimeoutSeconds", "appVisible"
        ]);
      allow delete: if isSuperAdmin();
    }

    match /enrollment_codes/{codeId} {
      allow read, write: if false;
    }

    match /device_commands/{commandId} {
      allow read: if isStaff();
      // The console may queue only non-destructive, user-visible requests.
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          "deviceId", "command", "payload", "status", "createdAt", "createdBy"
        ])
        && request.resource.data.command in [
          "request_check_in", "refresh_policy", "display_notice"
        ]
        && request.resource.data.status == "pending"
        && request.resource.data.deviceId is string
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if false;
    }

    match /device_installments/{installmentId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if isAdmin()
        && request.resource.data.deviceId is string
        && request.resource.data.ownerUid is string
        && request.resource.data.amountMinor is int
        && request.resource.data.amountMinor > 0
        && request.resource.data.currencyCode is string;
      allow update: if isAdmin()
        && request.resource.data.deviceId == resource.data.deviceId
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if isSuperAdmin();
    }

    match /device_installment_payments/{paymentId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if isAdmin()
        && request.resource.data.installmentId is string
        && request.resource.data.ownerUid is string
        && request.resource.data.amountMinor is int
        && request.resource.data.amountMinor > 0
        && request.resource.data.currencyCode is string;
      allow update, delete: if false;
    }

    match /device_finance_actions/{actionId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          "deviceId", "ownerUid", "installmentId", "type",
          "decision", "reason", "recordedBy", "createdAt"
        ])
        && request.resource.data.type == "payment_review"
        && request.resource.data.decision in ["approved", "declined"]
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 3
        && request.resource.data.reason.size() <= 500
        && request.resource.data.recordedBy == request.auth.uid;
      allow update, delete: if false;
    }

    match /audit_logs/{logId} {
      allow read: if isStaff();
      allow create, update, delete: if false;
    }

    match /device_locations/{locationId} {
      // Location data is sensitive: only Admin/Super Admin or the owner may read it.
      allow read: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create, update, delete: if false;
    }
  }
}